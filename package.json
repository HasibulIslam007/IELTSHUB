{
  "name": "ielts-practice-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.local/browsers playwright test",
    "test": "npm run build && cd backend && php artisan test",
    "start": "node scripts/dev.mjs --built",
    "setup": "node scripts/setup.mjs",
    "check": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "agent-browser": "^0.21.0"
  }
}
